# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Paystack (use test keys for local dev, live keys only in production)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Base URL used for Paystack callback links etc.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp number for the landing page "Message us" button, digits only with
# country code, no + or spaces (e.g. 2348012345678). Leave blank to hide the
# button until a real DFM business WhatsApp number is set.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_SENDER_EMAIL=
