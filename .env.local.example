# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, bypasses RLS — never expose to the browser. Only used in
# trusted server routes (Paystack payment confirmation).
SUPABASE_SERVICE_ROLE_KEY=

# Paystack (use test keys for local dev, live keys only in production)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Base URL used for Paystack callback links etc.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp number for the landing page "Message us" button, digits only with
# country code, no + or spaces (e.g. 2348012345678). Leave blank to hide the
# button until a real DFM business WhatsApp number is set.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_SENDER_EMAIL=

# Shared secret checked against the Authorization header on
# /api/cron/daily (see vercel.json) so only Vercel's own scheduled
# invocation can trigger recurring fees / preventive maintenance. Any
# random string works — generate one and set the same value in Vercel's
# project environment variables.
CRON_SECRET=

# ─── Error monitoring (Sentry) ─────────────────────────────────────────────────
# Same DSN value in both — DSNs aren't secret (they're shipped in the browser
# bundle by design), just identify which Sentry project to send events to.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional — only needed in the Vercel build environment, not local dev.
# Without it, Sentry still captures errors, just with minified/unreadable
# stack traces. Generate at sentry.io -> Settings -> Auth Tokens (needs
# project:releases scope), set only in Vercel's env vars, never commit it.
SENTRY_AUTH_TOKEN=
